model dat_document_category {
  id          String         @id @default(uuid())
  company_id  String
  code        String         @db.VarChar(50)
  name        String         @db.VarChar(255)
  description String?        @db.Text
  is_active   Boolean        @default(true)
  created_at  DateTime       @default(now())
  updated_at  DateTime       @default(now())
  documents   dat_document[]

  @@unique([company_id, code])
  @@index([company_id])
}

model dat_document {
  id           String                  @id @default(uuid())
  company_id   String
  category_id  String?
  code         String                  @db.VarChar(50)
  title        String                  @db.VarChar(255)
  description  String?                 @db.Text
  content_type String                  @default("markdown") @db.VarChar(20)
  content      String?                 @db.Text
  file_path    String?                 @db.Text
  file_name    String?                 @db.VarChar(255)
  file_size    BigInt?
  url          String?                 @db.Text
  version      String                  @default("1.0") @db.VarChar(20)
  status       String                  @default("DRAFT") @db.VarChar(20)
  created_by   String
  approved_by  String?
  approved_at  DateTime?
  is_active    Boolean                 @default(true)
  created_at   DateTime                @default(now())
  updated_at   DateTime                @default(now())
  category     dat_document_category?  @relation(fields: [category_id], references: [id])
  versions     dat_document_version[]
  approvals    dat_document_approval[]

  @@unique([company_id, code])
  @@index([company_id])
  @@index([category_id])
  @@index([status])
}

model dat_document_version {
  id          String       @id @default(uuid())
  document_id String
  company_id  String
  version     String       @db.VarChar(20)
  content     String?      @db.Text
  file_path   String?      @db.Text
  status      String       @db.VarChar(20)
  note        String?      @db.Text
  created_by  String
  created_at  DateTime     @default(now())
  document    dat_document @relation(fields: [document_id], references: [id])

  @@unique([document_id, version])
  @@index([document_id])
}

model dat_document_approval {
  id          String       @id @default(uuid())
  document_id String
  company_id  String
  action      String       @db.VarChar(20)
  note        String?      @db.Text
  user_id     String
  created_at  DateTime     @default(now())
  document    dat_document @relation(fields: [document_id], references: [id])

  @@index([document_id])
  @@index([company_id])
}

model dat_request {
  id              String             @id @default(uuid())
  company_id      String
  type_id         String
  requester_id    String
  code            String
  title           String
  description     String
  priority        String             @default("NORMAL")
  status          approval_info      @default(PENDING)
  current_step    Int                @default(1)
  completion_note String?
  completed_by    String?
  completed_at    DateTime?
  created_at      DateTime           @default(now())
  updated_at      DateTime           @default(now())
  company         dat_company        @relation(fields: [company_id], references: [id])
  type            dat_signature_type @relation(fields: [type_id], references: [id])
  requester       dat_user           @relation("RequestCreator", fields: [requester_id], references: [id])
  completer       dat_user?          @relation("RequestCompleter", fields: [completed_by], references: [id])

  @@unique([company_id, code])
  @@index([company_id, status])
  @@index([requester_id])
  @@index([type_id])
}

model dat_user {
  id              String               @id @default(uuid())
  username        String
  email           String
  password        String
  fullname        String
  phone           String?
  company_id      String               @default("")
  employee_id     String?
  location_id     String?
  department_id   String?
  division_id     String?
  role            String               @default("staff")
  job             String               @default("")
  key             String               @default("")
  is_admin        Boolean              @default(false)
  is_hris         Boolean              @default(false)
  is_active       Boolean              @default(false)
  created_at      DateTime             @default(now())
  updated_at      DateTime             @default(now())
  companies       dat_user_company[]
  areas           dat_user_area[]
  sessions        dat_user_session[]
  approval_signs  dat_approval_sign[]
  signature_flags dat_signature_flag[]
  requests        dat_request[]        @relation("RequestCreator")
  completed       dat_request[]        @relation("RequestCompleter")

  @@unique([company_id, username])
}

model dat_user_company {
  id         String               @id @default(uuid())
  user_id    String
  company_id String
  is_active  Boolean              @default(false)
  created_at DateTime             @default(now())
  updated_at DateTime             @default(now())
  user       dat_user             @relation(fields: [user_id], references: [id])
  company    dat_company          @relation(fields: [company_id], references: [id])
  privileges dat_user_privilege[]

  @@unique([user_id, company_id])
}

model dat_user_area {
  id              String           @id @default(uuid())
  user_id         String
  company_area_id String
  is_active       Boolean          @default(false)
  created_at      DateTime         @default(now())
  updated_at      DateTime         @default(now())
  user            dat_user         @relation(fields: [user_id], references: [id])
  company_area    dat_company_area @relation(fields: [company_area_id], references: [id])

  @@unique([user_id, company_area_id])
}

model dat_user_privilege {
  id              String           @id @default(uuid())
  user_company_id String
  module_id       String
  level           action_type      @default(HIDE)
  created_at      DateTime         @default(now())
  updated_at      DateTime         @default(now())
  user_company    dat_user_company @relation(fields: [user_company_id], references: [id])
  module          dat_module       @relation(fields: [module_id], references: [id])

  @@unique([user_company_id, module_id])
}

model dat_user_session {
  id         String   @id @default(uuid())
  user_id    String
  token      String   @unique
  ip_address String?
  user_agent String?
  created_at DateTime @default(now())
  expires_at DateTime
  user       dat_user @relation(fields: [user_id], references: [id])
}

model dat_user_action {
  id          String   @id @default(uuid())
  user_id     String
  company_id  String?
  module_code String?
  action      String
  path        String
  ip_address  String?
  user_agent  String?
  created_at  DateTime @default(now())

  @@index([user_id])
  @@index([company_id])
}

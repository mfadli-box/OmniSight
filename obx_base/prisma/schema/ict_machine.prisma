model ict_host_group {
  id          String   @id @default(uuid())
  company_id  String
  name        String   @db.VarChar(100)
  description String?  @db.Text
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now())

  @@unique([company_id, name])
  @@index([company_id])
}

model ict_host_group_member {
  id         String   @id @default(uuid())
  group_id   String
  host_id    String
  created_at DateTime @default(now())

  @@unique([group_id, host_id])
}

model ict_host_permission {
  id         String   @id @default(uuid())
  company_id String
  user_id    String
  ref_type   String   @db.VarChar(20)
  ref_id     String
  role       String   @default("viewer") @db.VarChar(20)
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  @@unique([user_id, ref_type, ref_id])
  @@index([company_id, user_id])
}

model ict_host {
  id               String    @id @default(uuid())
  company_id       String
  hostname         String    @db.VarChar(255)
  ip_address       String    @db.VarChar(45)
  vm_id            String    @db.VarChar(100)
  docker_version   String?   @db.VarChar(50)
  status           String    @default("stopped") @db.VarChar(50) // running, stopped, suspended, unknown
  os_type          String?   @db.VarChar(100)
  cpu_count        Int       @default(0)
  memory_mb        Int       @default(0)
  disk_gb          Int       @default(0)
  total_containers Int       @default(0)
  total_images     Int       @default(0)
  total_compose    Int       @default(0)
  agent_version    String?   @db.VarChar(20)
  last_seen        DateTime?
  last_heartbeat   DateTime?
  last_synced_at   DateTime?
  is_active        Boolean   @default(true)
  created_at       DateTime  @default(now())
  updated_at       DateTime  @default(now())

  @@unique([company_id, hostname])
  @@index([company_id])
}

model ict_host_status {
  id            String   @id @default(uuid())
  company_id    String
  host_id       String
  vm_id         String
  cpu_percent   Decimal  @default(0.00) @db.Decimal(5, 2)
  cpu_cores     Int      @default(0)
  mem_total_mb  Decimal  @default(0.00) @db.Decimal(12, 2)
  mem_used_mb   Decimal  @default(0.00) @db.Decimal(12, 2)
  mem_percent   Decimal  @default(0.00) @db.Decimal(5, 2)
  disk_total_gb Decimal  @default(0.00) @db.Decimal(12, 2)
  disk_used_gb  Decimal  @default(0.00) @db.Decimal(12, 2)
  disk_percent  Decimal  @default(0.00) @db.Decimal(5, 2)
  net_rx_bps    BigInt   @default(0)
  net_tx_bps    BigInt   @default(0)
  uptime_sec    BigInt   @default(0)
  status        String   @db.VarChar(20) // running, stopped, suspended
  recorded_at   DateTime @default(now())

  @@index([host_id, recorded_at])
  @@index([company_id, recorded_at])
  @@index([recorded_at])
}

model ict_docker_compose {
  id              String    @id @default(uuid())
  company_id      String
  host_id         String
  name            String    @db.VarChar(100)
  compose_content String    @db.Text
  file_path       String?   @db.Text
  env_vars        Json?     @default("[]")
  version         String?   @db.VarChar(20)
  status          String    @default("undeployed") @db.VarChar(20)
  deploy_status   String    @default("pending") @db.VarChar(20)
  deployed_at     DateTime?
  is_active       Boolean   @default(true)
  created_at      DateTime  @default(now())
  updated_at      DateTime  @default(now())
  last_synced_at  DateTime?

  @@unique([company_id, host_id, name])
  @@index([host_id])
  @@index([company_id])
}

model ict_docker_container {
  id             String    @id @default(uuid())
  company_id     String
  host_id        String
  name           String    @db.VarChar(100)
  image          String    @db.VarChar(255)
  tag            String    @default("latest") @db.VarChar(100)
  ports          Json?     @default("[]")
  volumes        Json?     @default("[]")
  env            Json?     @default("[]")
  network        String?   @db.VarChar(100)
  restart_policy String    @default("unless-stopped") @db.VarChar(30)
  command        String?   @db.Text
  status         String    @default("created") @db.VarChar(20)
  container_id   String?   @db.VarChar(100)
  deploy_status  String    @default("pending") @db.VarChar(20)
  deployed_at    DateTime?
  is_active      Boolean   @default(true)
  created_at     DateTime  @default(now())
  updated_at     DateTime  @default(now())
  last_synced_at DateTime?

  @@unique([company_id, host_id, name])
  @@index([host_id])
  @@index([company_id])
}

model ict_docker_container_stat {
  id             String   @id @default(uuid())
  company_id     String
  host_id        String
  container_name String   @db.VarChar(100)
  container_id   String?  @db.VarChar(100)
  cpu_percent    Decimal  @default(0.00) @db.Decimal(5, 2)
  mem_usage_mb   Decimal  @default(0.00) @db.Decimal(12, 2)
  mem_limit_mb   Decimal  @default(0.00) @db.Decimal(12, 2)
  mem_percent    Decimal  @default(0.00) @db.Decimal(5, 2)
  net_rx_bytes   BigInt   @default(0)
  net_tx_bytes   BigInt   @default(0)
  block_rx_bytes BigInt   @default(0)
  block_tx_bytes BigInt   @default(0)
  pid_count      Int      @default(0)
  restart_count  Int      @default(0)
  uptime_seconds BigInt   @default(0)
  status         String   @db.VarChar(20)
  recorded_at    DateTime @default(now())

  @@index([host_id, container_name, recorded_at])
  @@index([company_id, recorded_at])
  @@index([recorded_at])
}

model ict_docker_image {
  id             String    @id @default(uuid())
  company_id     String
  host_id        String
  name           String    @db.VarChar(255)
  tag            String    @default("latest") @db.VarChar(100)
  digest         String?   @db.VarChar(255)
  size_bytes     BigInt?   @default(0)
  pulled_at      DateTime?
  is_active      Boolean   @default(true)
  created_at     DateTime  @default(now())
  last_synced_at DateTime?

  @@unique([company_id, host_id, name, tag])
  @@index([host_id])
}

model ict_docker_network {
  id             String    @id @default(uuid())
  company_id     String
  host_id        String
  name           String    @db.VarChar(100)
  driver         String    @default("bridge") @db.VarChar(20)
  subnet         String?   @db.VarChar(45)
  gateway        String?   @db.VarChar(45)
  internal       Boolean   @default(false)
  attachable     Boolean   @default(false)
  is_active      Boolean   @default(true)
  created_at     DateTime  @default(now())
  updated_at     DateTime  @default(now())
  last_synced_at DateTime?

  @@unique([host_id, name])
  @@index([host_id])
}

model ict_docker_network_member {
  id           String   @id @default(uuid())
  network_id   String
  container_id String
  created_at   DateTime @default(now())

  @@unique([network_id, container_id])
}

model ict_docker_share {
  id         String    @id @default(uuid())
  company_id String
  name       String    @db.VarChar(100)
  token      String    @unique @db.VarChar(64)
  config     Json      @default("{}")
  is_active  Boolean   @default(true)
  expires_at DateTime?
  created_by String
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now())

  @@index([company_id])
  @@index([token])
}

model ict_docker_backup {
  id            String    @id @default(uuid())
  company_id    String
  host_id       String
  backup_type   String    @db.VarChar(20)
  ref_id        String?
  file_path     String    @db.Text
  file_size     BigInt    @default(0)
  status        String    @default("pending") @db.VarChar(20)
  error_message String?   @db.Text
  created_by    String
  created_at    DateTime  @default(now())
  completed_at  DateTime?

  @@index([host_id, backup_type])
  @@index([company_id])
}

model ict_docker_deploy {
  id            String    @id @default(uuid())
  company_id    String
  host_id       String
  job_type      String    @db.VarChar(30)
  ref_id        String?
  action        String    @db.VarChar(30)
  status        String    @default("pending") @db.VarChar(20)
  log           String?   @db.Text
  error_message String?   @db.Text
  started_at    DateTime?
  completed_at  DateTime?
  created_by    String
  created_at    DateTime  @default(now())

  @@index([host_id, status])
  @@index([company_id])
}

model ict_git_webhook {
  id             String    @id @default(uuid())
  company_id     String
  name           String    @db.VarChar(100)
  provider       String    @db.VarChar(20)
  repo_url       String    @db.VarChar(500)
  repo_full_name String    @db.VarChar(255)
  branch         String    @default("main") @db.VarChar(100)
  secret_token   String    @db.VarChar(255)
  is_active      Boolean   @default(true)
  last_trigger   DateTime?
  last_status    String?   @db.VarChar(20)
  created_at     DateTime  @default(now())
  updated_at     DateTime  @default(now())

  @@unique([company_id, name])
  @@index([company_id])
}

model ict_git_deploy_mapping {
  id           String   @id @default(uuid())
  company_id   String
  webhook_id   String
  ref_type     String   @db.VarChar(20)
  ref_id       String
  file_pattern String   @db.VarChar(255)
  auto_deploy  Boolean  @default(true)
  created_at   DateTime @default(now())

  @@index([webhook_id])
  @@index([company_id])
}

model ict_git_deploy_log {
  id              String   @id @default(uuid())
  company_id      String
  webhook_id      String
  mapping_id      String?
  event_type      String   @db.VarChar(30)
  commit_sha      String?  @db.VarChar(64)
  commit_msg      String?  @db.Text
  ref             String   @db.VarChar(100)
  pusher_name     String?  @db.VarChar(100)
  changed_files   Json?    @default("[]")
  matched         Boolean  @default(false)
  deploy_job_id   String?
  payload_size    Int      @default(0)
  signature_valid Boolean  @default(true)
  status          String   @default("received") @db.VarChar(20)
  error_message   String?  @db.Text
  created_at      DateTime @default(now())

  @@index([webhook_id, created_at])
  @@index([company_id])
}
